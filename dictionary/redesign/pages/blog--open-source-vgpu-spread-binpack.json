c98c":"\n}\n","sb49b5431a355cf":"主要就是下面这几句：","s80b5404e484fd9":"// 计算得分，拿到所有满足条件的节点","s59e0a28ba8e9c4":"\nnodeScores, err := s.calcScore(nodeUsage, nums, annos, args.Pod)\n\n","s1edfd9c476154e":"// 排序","s41b08162b1b87d":"\nsort.Sort(nodeScores)\n","s97a565b71dd2eb":"// 直接选择最后一个节点","s4dfb50f0723b5d":"\nm := (*nodeScores).NodeList[","sb79ddd841a1628":"]\n\n","s87a5ca92525c86":"// 返回结果","scc25672608a7ea":"\nres := extenderv1.ExtenderFilterResult{NodeNames: &[]","s5f70615158a33b":"{m.NodeID}}\n","s22a0cdb8db1fc2":"可以分为两个部分：","sb76679f5328736":"为所有节点计算得分","se6e87786cf1285":"根据调度策略选择最合适的节点","s20cdc3c3d81496":"计算得分","sd3ce7854f4de70":"得分计算逻辑在 calcScore 方法里：","s107314e0d2791b":"// pkg/scheduler/score.go#L185","s781a86a9f5f06e":" calcScore(nodes *","sfd6bca1fed2709":"]*NodeUsage, nums util.PodDeviceRequests, annos ","s211a94fd737fb5":", task *corev1.Pod) (*policy.NodeScoreList, ","s7428e6b8b16203":") {\n    userNodePolicy := config.NodeSchedulerPolicy\n    ","sca4f7234bd39fc":" annos != ","s8ad1d08da24a29":" {\n        ","sa297d1984ccb9b":" value, ok := annos[policy.NodeSchedulerPolicyAnnotationKey]; ok {\n            userNodePolicy = value\n        }\n    }\n    res := policy.NodeScoreList{\n        Policy:   userNodePolicy,\n        NodeList: ","s3f327aa2b0bc61":"([]*policy.NodeScore, ","s2c66dcb535c5aa":"),\n    }\n\n    ","sb0dff61c355577":" nodeID, node := ","sddbc173acc287b":" *nodes {\n        viewStatus(*node)\n        score := policy.NodeScore{NodeID: nodeID, Devices: ","sd6dd8ee277386a":"(util.PodDevices), Score: ","sc7dd714aac4fe1":"}\n        score.ComputeScore(node.Devices)\n\n        ctrfit := ","sfcbcf165908dd1":"false","s31b0119e107ff4":" ctrid, n := ","s719fedb4aec27b":" nums {\n            sums := ","s4172d4f8560004":" n {\n                sums += ","s87d180dc28ebf0":"(k.Nums)\n            }\n\n            ","sce5363d8cf1c94":" sums == ","se681f6e1db78c3":" {\n                ","s70d06600df27d9":" idx := ","s499998d76bfaff":" score.Devices {\n                    ","s48d82cb7082ea9":"(score.Devices[idx]) <= ctrid {\n                        score.Devices[idx] = ","sae524b54d9b5ac":"append","s0c8c298003d073":"(score.Devices[idx], util.ContainerDevices{})\n                    }\n                    score.Devices[idx][ctrid] = ","s4ca02630a18cfc":"(score.Devices[idx][ctrid], util.ContainerDevice{})\n                }\n                ","se256ee8e7aff69":"continue","sac1de38d290a3b":"\n            }\n\n            klog.V(","sdac26470f5fa67":"\"fitInDevices\"","sda1089106e43d0":", klog.KObj(task), ","s0f61677887e8c6":"\"node\"","s91c58788b35764":", nodeID)\n            fit, _ := fitInDevices(node, n, annos, task, &score.Devices)\n            ctrfit = fit\n            ","sfb124600f9eb6b":" !fit {\n                klog.InfoS(","s980f5fe06b5692":"\"calcScore:node not fit pod\"","sd80142eb7aec62":", nodeID)\n                ","s14ebe56a5008e7":"break","s90eaa8e7906352":"\n            }\n        }\n\n        ","s7f9912673bbeb0":" ctrfit {\n            res.NodeList = ","s9c23e61670ccc9":"(res.NodeList, &score)\n        }\n    }\n    ","sa2bce7430cbc8f":"具体算法在 ComputeScore 中：","sa83a57738f29eb":"// pkg/scheduler/policy/node_policy.go#L53","s2e215191b45b9e":"(ns *NodeScore)","sa247d9d07213c5":" ComputeScore(devices DeviceUsageList) {\n    ","sa4f605e2121b07":"// current user having request resource","s2f51a63b44b0cd":"\n    used, usedCore, usedMem := ","s05c31294577520":"int32","s8c983aa96747e2":"), ","s3d7928ec630bf0":")\n    ","sdca7b72dd6692a":" _, device := ","s048d62ff26e340":" devices.DeviceLists {\n        used += device.Device.Used\n        usedCore += device.Device.Usedcores\n        usedMem += device.Device.Usedmem\n    }\n    klog.V(","sd4735e3a265e16":"2","sc3fa2dd92266f7":"\"node %s used %d, usedCore %d, usedMem %d,\"","s11453e6acbc44e":", ns.NodeID, used, usedCore, usedMem)\n\n    total, totalCore, totalMem := ","s01380c6a33ea68":" _, deviceLists := ","s0ca1ddc012186a":" devices.DeviceLists {\n        total += deviceLists.Device.Count\n        totalCore += deviceLists.Device.Totalcore\n        totalMem += deviceLists.Device.Totalmem\n    }\n    useScore := ","s6a937d727b77c2":"float32","s741b662ea2e94f":"(used) / ","sd1eac4fb510cc0":"(total)\n    coreScore := ","sf8ba11eb1c92c1":"(usedCore) / ","s675820f1f33bff":"(totalCore)\n    memScore := ","s9809a8354b6243":"(usedMem) / ","sd8a9f7f4ae92c4":"(totalMem)\n    ns.Score = ","s7c3245d7c8d15a":"(Weight) * (useScore + coreScore + memScore)\n    klog.V(","s0c0138be24893c":"\"node %s computer score is %f\"","sabfdffc3077134":", ns.NodeID, ns.Score)\n}\n","sd69441990c8583":"具体打分逻辑则是根据每个节点上的已经使用的 GPU Core、GPU Memory 资源和总的 GPU Core、GPU Memory 的比值，根据权重归一化处理后得到最终的得分。","s6d2f209e2038ae":"总的来说就是：","s977210cdebaaaf":"节点上 GPU Core 和 GPU Memory 资源剩余越少，得分越高。","sde3d515d6cf573":"乍一看这个逻辑有点反直觉了，不是应该资源越多得分越高吗。","sf6aa97c3d51040":"问题不大，等看完后续 根据策略选择节点 章节就清楚了。","s8dbe8801b7fd18":"过滤节点","s08ef51b4f0616a":"打分之后还需要根据 Pod 申请的 GPU 信息，过滤掉不满足条件的节点。","se7d0b07889d940":"比如：Pod 申请 2 vGPU，Node 上只有一张卡，肯定是不行的。","s5d4351f0b13d79":"解析 Pod 申请的 GPU 信息","s23c7a8c07a0a58":"首先是从 Pod 信息中解析出申请的 GPU 信息：","s1b6bf40ec3f747":") {\n    nums := k8sutil.Resourcereqs(args.Pod)\n}\n","sdfa25083f6ea73":"Resourcereqs 内容如下：","s361b37acf26e01":"// pkg/k8sutil/pod.go#L27","s64a9bdd48d2a09":"Resourcereqs","s744dbde9a74261":"(pod *corev1.Pod)","sf7c875a05da3b5":" (counts util.PodDeviceRequests) {\n    counts = ","s51eb4858651b5d":"(util.PodDeviceRequests, ","s38ea0757e15eaf":"(pod.Spec.Containers))\n    ","s13747165c00282":"// Count Nvidia GPU","sd0bb3491fd367d":" i := ","s12794540017aee":"; i < ","se6260b6d46e440":"(pod.Spec.Containers); i++ {\n        devices := device.GetDevices()\n        counts[i] = ","s9df8b1a91cbb72":"(util.ContainerDeviceRequests)\n        ","sb34c7f89ba1122":" idx, val := ","sbadcc144dfefeb":" devices {\n            request := val.GenerateResourceRequests(&pod.Spec.Containers[i])\n            ","sb59c47f37a4f29":" request.Nums > ","s40d8e3fa96506b":" {\n                counts[i][idx] = val.GenerateResourceRequests(&pod.Spec.Containers[i])\n            }\n        }\n    }\n    klog.InfoS(","s52ecc24bef1791":"\"collect requestreqs\"","s98ef00230c78e2":"\"counts\"","s601e3a2a624074":", counts)\n    ","s44f90df6f8a7e0":" counts\n}\n","s4407c4e85720c0":"GenerateResourceRequests 是 Interface，以 NVIDIA 实现为例","s32c96096ee382c":"// pkg/device/nvidia/device.go#L264","sbc8d5b1c68a51d":"(dev *NvidiaGPUDevices)","sfc9241c1ecb9e6":" GenerateResourceRequests(ctr *corev1.Container) util.ContainerDeviceRequest {\n    resourceName := corev1.ResourceName(ResourceName)\n    resourceMem := corev1.ResourceName(ResourceMem)\n    resourceMemPercentage := corev1.ResourceName(ResourceMemPercentage)\n    resourceCores := corev1.ResourceName(ResourceCores)\n\n    v, ok := ctr.Resources.Limits[resourceName]\n    ","sbf063fbae0beca":" !ok {\n        v, ok = ctr.Resources.Requests[resourceName]\n    }\n    ","s27cdf297636632":" ok {\n        ","sa411223810969e":" n, ok := v.AsInt64(); ok {\n            memnum := ","s9bca7935bf238c":"\n            mem, ok := ctr.Resources.Limits[resourceMem]\n            ","sb8cd3e983320aa":" !ok {\n                mem, ok = ctr.Resources.Requests[resourceMem]\n            }\n            ","s35706a31b5231d":" ok {\n                memnums, ok := mem.AsInt64()\n                ","s2cfc8f9e0a993d":" ok {\n                    memnum = ","sdbd85121d31951":"(memnums)\n                }\n            }\n\n            mempnum := ","s16dc368a89b428":"101","sa7a99b4901198f":")\n            mem, ok = ctr.Resources.Limits[resourceMemPercentage]\n            ","sdd5079d3b65edc":" !ok {\n                mem, ok = ctr.Resources.Requests[resourceMemPercentage]\n            }\n            ","s21ffff59f0e260":" ok {\n                mempnums, ok := mem.AsInt64()\n                ","s2b5fb6123972c7":" ok {\n                    mempnum = ","s6ddf6a71fab413":"(mempnums)\n                }\n            }\n\n            ","s384685d810858d":" mempnum == ","sd8fbd283ce3ea4":" && memnum == ","sef0b6f9ab86c51":" config.DefaultMem != ","sac3a69fc22b7ec":" {\n                    memnum = ","s0a343511a5c9ea":"(config.DefaultMem)\n                } ","s7dd530c4d36da4":"else","scb0042fd1ed67a":" {\n                    mempnum = ","sad57366865126e":"100","sb49e93b163de0d":"\n                }\n            }\n\n            corenum := config.DefaultCores\n            core, ok := ctr.Resources.Limits[resourceCores]\n            ","s9de6d855c5bd74":" !ok {\n                core, ok = ctr.Resources.Requests[resourceCores]\n            }\n            ","s3c636723ca61a4":" ok {\n                corenums, ok := core.AsInt64()\n                ","sf57edae5068c4a":" ok {\n                    corenum = ","s1910c1e993997e":"(corenums)\n                }\n            }\n\n            ","sc48d7b532b4aba":" util.ContainerDeviceRequest{\n                Nums:             ","sa86fe52653a3f9":"(n),\n                Type:             NvidiaGPUDevice,\n                Memreq:           ","s0316a277362ac2":"(memnum),\n                MemPercentagereq: ","s07ca702ee3ba3f":"(mempnum),\n                Coresreq:         ","s0f68f66de93495":"(corenum),\n            }\n        }\n    }\n    ","s39ac67bdb6ee54":" util.ContainerDeviceRequest{}\n}\n","sd15b20d0f22258":"逻辑也比较简单，就是从 Container 的 Resources 中根据名称解析拿到申请的 gpu、gpucore、gpumem 等信息。","s545ca4c007ce36":"逻辑同样在 calcScore 方法中，具体如下：","sf4460f6d11a84c":"ctrfit := ","se5779793de61b7":" nums {\n    sums := ","s221e2b59d0bf4b":" n {\n        sums += ","sb29a6929918fcf":"(k.Nums)\n    }\n\n    ","s596d44b99a7259":" score.Devices {\n            ","se85c6e8aeb0d7c":"(score.Devices[idx]) <= ctrid {\n                score.Devices[idx] = ","sbf9352444ca42e":"(score.Devices[idx], util.ContainerDevices{})\n            }\n            score.Devices[idx][ctrid] = ","s17979c61ee193f":"(score.Devices[idx][ctrid], util.ContainerDevice{})\n        }\n        ","s936de7da32d8d1":"\n    }\n\n    klog.V(","sbb2c971e690765":", nodeID)\n    fit, _ := fitInDevices(node, n, annos, task, &score.Devices)\n    ctrfit = fit\n    ","s30645509134d98":" !fit {\n        klog.InfoS(","s48b1e6c7a83dcc":", nodeID)\n        ","s5ed716f72eb642":"\n    }\n}\n\n","s11cdff28804641":" ctrfit {\n    res.NodeList = ","sd84033440aae1c":"(res.NodeList, &score)\n}\n","sbf2feb5241937e":"nums 就是上一步解析出来的 Pod 的 GPU 申请情况","s14d5774cbe304b":"score.Devices：就是当前节点上的 GPU 设备","s330eb622a6428e":"具体过滤规则在这里：","s10d5a173c01d0c":"fit, _ := fitInDevices(node, n, annos, task, &score.Devices)\n","s2865f0d7994bf9":"fitInDevices 内容如下：","s40a4d21fa1e0ad":"内容比较多，去掉了其他无关内容，主要就是做了这几个判断，如果都满足则记录对应的 GPU 信息并返回 true，否则返回 false，表示该节点无法调度。","sd14bb48187bcb3":"fitInCertainDevice","s0f6d9cbaa5f475":"(node *NodeUsage, request util.ContainerDeviceRequest, annos ","s5c089a14f0192b":", pod *corev1.Pod)","s4f5a2ada116617":" (","sb760f44fa5965c":"bool","s109e98d549218a":"]util.ContainerDevices) {\n    ","s5c2749c1de0252":"// ....","s8f3c01db5121be":"(node.Devices.DeviceLists) - ","s83623c60123b17":"; i >= ","s52d488693ae3cc":"; i-- {\n        ","s897cbce3104d1d":" node.Devices.DeviceLists[i].Device.Totalmem-node.Devices.DeviceLists[i].Device.Usedmem < memreq {\n            ","s1da3336dc259ab":"\n        }\n        ","s1a196eade491b7":" node.Devices.DeviceLists[i].Device.Totalcore-node.Devices.DeviceLists[i].Device.Usedcores < k.Coresreq {\n            ","s1f07c93c4aed96":"// Coresreq=100 indicates it want this card exclusively","s7d1efff89ac2a1":" node.Devices.DeviceLists[i].Device.Totalcore == ","sa183453376af11":" && k.Coresreq == ","s00941b7d5ee811":" && node.Devices.DeviceLists[i].Device.Used > ","sffdecb6e62b16b":" {\n            ","sf91645984e81c2":"// You can't allocate core=0 job to an already full GPU","sff0b8a2c4fe439":" node.Devices.DeviceLists[i].Device.Totalcore != ","s0bbeb7caff30b4":" && node.Devices.DeviceLists[i].Device.Usedcores == node.Devices.DeviceLists[i].Device.Totalcore && k.Coresreq == ","s7f56da4639aa88":" k.Nums > ","sb7f49fe091b489":" {\n            klog.InfoS(","s7081da5d651309":"\"first fitted\"","s91001a331b5d4c":", klog.KObj(pod), ","s320e21f3ce6874":"\"device\"","secb83564d240ff":", node.Devices.DeviceLists[i].Device.ID)\n            k.Nums--\n            tmpDevs[k.Type] = ","se9cae265c335d9":"(tmpDevs[k.Type], util.ContainerDevice{\n                Idx:       ","s1b7cf96d40ca2a":"(node.Devices.DeviceLists[i].Device.Index),\n                UUID:      node.Devices.DeviceLists[i].Device.ID,\n                Type:      k.Type,\n                Usedmem:   memreq,\n                Usedcores: k.Coresreq,\n            })\n        }\n        ","s6997a652e236cd":" k.Nums == ","s2331f32e2a3431":"\"device allocate success\"","s86ca5b85c87de0":"\"allocate device\"","s4b51a2f29ef232":", tmpDevs)\n            ","sb5bea41b6c623f":"true","sde455938b3c8c0":", tmpDevs\n        }\n    }\n    ","sf40445e62c3ee7":", tmpDevs\n}\n","s803131dadf5fad":"这样，我们就把不满足条件的节点给过滤掉了，剩下的节点都是可以正常调度 Pod 的，不过具体选择哪个节点还需要依赖于配置的调度策略。","s48a8788f424e63":"根据策略选择节点","sfa55164ca0cdbd":"上一步计算出了每个节点的得分之后，就可以根据策略进行选择了。","sae7b1a695bf416":"具体的选择逻辑在这里：","sf9416e09f78ba3":"]\n","s9e8772fb1d2c83":"对得分数据排序后，直接就选择了最后一个节点。","s3c09c21b730f5d":"初次看到这里时也有点懵，想不明白这怎么和调度策略牵扯到一起的。","sbb5b3779896dc7":"实际上具体逻辑就在 sort 这里","s2d85f0beb4080c":",NodeScoreList 要实现 sort 接口才能进行排序，因此看下是怎么实现的：","s6f95490eceeb73":"// pkg/scheduler/policy/node_policy.go#L32","s1303c06b0b014d":"type","s1cda1623a43bfd":" NodeScoreList ","s04b84ba1d4f1d3":"struct","s9624dc24fa2da1":" {\n    NodeList []*NodeScore\n    Policy   ","s0fc5d8ec7d53a9":"\n}\n\n","sb735b539d8126b":"(l NodeScoreList)","s6ccd6de9be9c04":" Len() ","sc45780d13d856f":" {\n    ","sa257b3b6a70708":"(l.NodeList)\n}\n\n","s6f2f23ddca8e98":" Swap(i, j ","sf20efd0eaddd5a":") {\n    l.NodeList[i], l.NodeList[j] = l.NodeList[j], l.NodeList[i]\n}\n\n","s7c7ff477330421":" Less(i, j ","sdaac4fe11107ed":") ","s4b81c2a75fb94b":" l.Policy == NodeSchedulerPolicySpread.String() {\n        ","sbe0f85f7d0b96d":" l.NodeList[i].Score > l.NodeList[j].Score\n    }\n    ","s763c8b25824272":"// default policy is Binpack","s6182acd685ec4c":" l.NodeList[i].Score < l.NodeList[j].Score\n}\n","sfd775114af96c5":"核心部分：","sd724051ed2bdd7":"根据我们的 Policy 不同，有两种排序方式，而且排序正好相反。","s31b2a851e7d961":"// NodeSchedulerPolicyBinpack is node use binpack scheduler policy.","s362fb52b4e3949":"\nNodeSchedulerPolicyBinpack SchedulerPolicyName = ","sead7235c9389a5":"\"binpack\"","se82408cfb89601":"// NodeSchedulerPolicySpread is node use spread scheduler policy.","sb567f6327319f3":"\nNodeSchedulerPolicySpread SchedulerPolicyName = ","sa27f5024cf953d":"\"spread\"","s6070234a320ba2":"这里涉及到 sort.Sort() 的实现，简单来说：","s9aeb5a2eb84f2f":"如果 Less() 方法中使用大于（>）比较，最终排序结果将是降序。","s63cd7393317918":"如果 Less() 方法中使用小于（<）比较，最终排序结果将是升序。","s994857588efb88":"对应到调度策略：","s73667a49446d93":"Binpack 策略","s090bbceb43be89":"使用 小于（<）比较，最终排序结果将是升序","s1dfe6204c7ae44":"Spread 策略","se205a004636fda":"使用 大于（>）比较，最终排序结果将是降序","s0febf6d34d0746":"又因为前面打分时的规则是：","s45ad0d1932e543":"剩余资源越少，得分越低，","s478c03d1c02fa5":"再加上我们会","s06a47a83ced952":"选择排序后的最后一个节点。","s550cf7c8c41849":"至此，逻辑就清晰了。","s5989c46cbeb6c4":"Binpack 策略选择最后一个节点，因为升序排列，最后一个 Node 得分最高，即：空闲资源最少","sa06bf27a4d728e":"Spread 策略选择最后一个节点，因为降序排列，最后一个 Node 得分最低，即：空闲资源最多","s9c813a2f77dd44":"正好符合了策略的原本含义：","s8867dae8a8a80b":"Binpack 则是让所有 Pod 尽量调度到同一个节点，优先把一个节点资源用完，然后再使用其他节点。","s6798924558b002":"Spread 则是相反，尽量让 Pod 分散到所有节点上去。","s74aeefb75da12c":"调度策略是哪儿来的","se54ea5286aedf1":"这部分逻辑实际上是在 calScore 方法里：","s61d6d01f6ae68b":"),\n    }\n}\n","scdea6a7ec20e77":"首先使用默认的调度策略，当然默认调度策略也是会被参数覆盖的：","s46afe74291e8ac":"rootCmd.Flags().StringVar(&config.NodeSchedulerPolicy, ","s0397b5819ddaa0":"\"node-scheduler-policy\"","sd78a34b1dae9fc":", policy.NodeSchedulerPolicyBinpack.String(), ","s18c767cdf6eb5b":"\"node scheduler policy\"","scba58d1f53c7cf":")\nrootCmd.Flags().StringVar(&config.GPUSchedulerPolicy, ","s44a20c27f5d487":"\"gpu-scheduler-policy\"","s2d9480527a1497":", policy.GPUSchedulerPolicySpread.String(), ","s51f332d8932cb2":"\"GPU scheduler policy\"","sfafba0527c3953":")\n","s4aadbda46c6f06":"然后解析 Pod 的 Annoations，如果有指定 hami.io/node-scheduler-policy 就使用 Pod 上指定的调度策略。","s1b604eca5c3d04":"至此，Node 调度策略就分析完成了。","s4fce2c12fd09fd":"3.GPU 调度策略原理","sdc29b0bfa1e1b2":"当 Node 选好之后，Node 上有多块 GPU，Pod 还分配哪块呢？这时候就该 GPU 调度策略生效了。","sd892ca23038492":"实际上选择 GPU 的逻辑也暗含在 Filter 方法里了。","s2adff07f825f2e":"过滤 GPU","s84d2819d1a7a2b":"和 Node 调度策略中的一样，这里就不在赘述了。","s06ba159df7ce63":"这部分逻辑隐藏比较深刻，在 fitInDevices 方法中","s3c50a97a62667b":") {\n    ","s18508ae4fb05f3":" *nodes {\n        fit, _ := fitInDevices(node, n, annos, task, &score.Devices)\n    }\n}\n","s2dc6b60731ed3d":"fitInDevices","sb2a07a2e9de2ec":"(node *NodeUsage, requests util.ContainerDeviceRequests, annos ","sef0ebdf64d0abc":", pod *corev1.Pod, devinput *util.PodDevices)","s52991104d785d4":") {\n    devs := util.ContainerDevices{}\n    total, totalCore, totalMem := ","s51415a8894a01c":")\n    free, freeCore, freeMem := ","sceea343b5a8514":")\n    sums := ","s9e111007a524f2":"// computer all device score for one node","s7e43ba9bc9ebd0":" index := ","s84f481d398e901":" node.Devices.DeviceLists {\n        node.Devices.DeviceLists[index].ComputeScore(requests)\n    }\n\n    ","s6bb594a69e6cd5":"// This loop is for requests for different devices","s1fc1e01cbc1835":" requests {\n        sums += ","s9f7348802ca994":"(k.Nums)\n        ","s7199f98d42504d":"(k.Nums) > ","s2828e5a6875893":"(node.Devices.DeviceLists) {\n            klog.InfoS(","s754235e132b055":"\"request devices nums cannot exceed the total number of devices on the node.\"","s2cad86c883529b":",\n                ","s33a5a95f433968":", klog.KObj(pod),\n                ","sf155be57f3a368":"\"request devices nums\"","s323d708e1d7a80":", k.Nums,\n                ","sc86afd08a07756":"\"node device nums\"","s51f079fa223309":"(node.Devices.DeviceLists))\n            ","s5be634e781d3aa":"\n        }\n\n        sort.Sort(node.Devices)\n        fit, tmpDevs := fitInCertainDevice(node