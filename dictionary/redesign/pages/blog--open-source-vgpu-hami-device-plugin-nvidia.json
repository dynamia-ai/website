e670944c7":"(ds Devices)","s9bde32882f8da7":" GetPluginDevices() []*kubeletdevicepluginv1beta1.Device {\n ","s4b7c1d419d39b1":" res []*kubeletdevicepluginv1beta1.Device\n\n ","s87f4db709d4ea0":" !strings.Contains(ds.GetIDs()[","s9b0210b8829c24":"], ","sdae35647f04aca":"\"MIG\"","se9797afa21b8fc":") {\n  ","s377c281c58ab30":" _, dev := ","sc10e8288eafd50":" ds {\n   ","sc3f2029bb0eab1":"uint","s5a2e3fab45f1d7":"); i < *util.DeviceSplitCount; i++ {\n    id := fmt.Sprintf(","s919deaf263a1ef":", dev.ID, i)\n    res = ","sced7a03da452a8":"(res, &kubeletdevicepluginv1beta1.Device{\n     ID:       id,\n     Health:   dev.Health,\n     Topology: ","s127b500db75deb":",\n    })\n   }\n  }\n } ","s7432913a34cb97":" _, d := ","seb63982e2ad8fa":" ds {\n   res = ","s13f2d046271213":"(res, &d.Device)\n  }\n }\n\n ","sea12d4584fdf40":" res\n}\n","sc852b3e576ce61":" ds {\n ","s9abde89c5e39f3":"); i < *util.DeviceSplitCount; i++ {\n  id := fmt.Sprintf(","s9e2ca747e34ce6":", dev.ID, i)\n  res = ","s336c03572171e3":"(res, &kubeletdevicepluginv1beta1.Device{\n   ID:       id,\n   Health:   dev.Health,\n   Topology: ","s143d70a46e13a4":",\n  })\n }\n}\n","sb3c4c5792dcfc8":"ListAndWatch 没有太多额外逻辑，主要和 TimeSlicing 类似的，根据 DeviceSplitCount 进行 Device 复制操作。","sd791636fe09eba":"因为虽然 HAMi 可以实现 GPU 切分，但是 k8s 中每个 Pod 都会把申请的 Resource 消耗掉，因此为了符合 k8s 逻辑，一般都会选择对物理 GPU 进行复制，便于运行更多的 GPU。","s433b550ca42f02":"5.Allocate","sae8c15e4deed96":"HAMi 的 Allocate 实现中包含两部分：","s52b0d9efd3dec6":"HAMi 的自定义逻辑","s91b7fa9482be09":"：主要是根据 Pod Resource 中的申请资源数量设置对应的环境变量，以及挂载 libvgpu.so 以替换 Pod 中的原生驱动","s8aa14ccd3dedbd":"NVIDIA 的原生逻辑","s4ee893bdf2dfd1":"：则是设置 NVIDIA_VISIBLE_DEVICES 这个环境变量，然后由 NVIDIA Container Toolkit 对该容器分配 GPU。","sdd221aedc20012":"因为 HAMi 并没有为容器分配 GPU 的能力，因此除了 HAMi 自定义的逻辑之外，还把 NVIDIA 的原生逻辑也加上了。","s7c2a9b5d56b3ed":"这样 Pod 中有环境变量，NVIDIA Container Toolkit 就会为其分配 GPU，然后 HAMi 自定义逻辑中替换 libvgpu.so 和添加部分环境变量，以此来实现了对 GPU 的限制。","sce611e8fcd912f":"HAMi 自定义逻辑","scea7b5e7e98836":"HAMi nvidia-device-plugin 的 Allocate 实现如