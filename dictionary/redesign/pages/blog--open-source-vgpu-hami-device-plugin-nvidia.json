o 的 Mounts 配置，后续这个 libvgpu.so 就会根据这些环境变量做 Core&Memory 的限制。","sab6387bee1e8d3":"// pkg/device-plugin/nvidiadevice/nvinternal/plugin/server.go#L423","s797f892710d921":" getAllocateResponse(requestIds []","s8928efb70f8a85":") (*kubeletdevicepluginv1beta1.ContainerAllocateResponse, ","s334284c4a1d7d2":") {\n deviceIDs := plugin.deviceIDsFromAnnotatedDeviceIDs(requestIds)\n\n responseID := uuid.New().String()\n response, err := plugin.getAllocateResponseForCDI(responseID, deviceIDs)\n ","se8ee027d02cbe2":"\"failed to get allocate response for CDI: %v\"","s5a44a0b0b49c3c":", err)\n }\n\n response.Envs = plugin.apiEnvs(plugin.deviceListEnvvar, deviceIDs)\n\n ","sc26140ddcfbac3":" *plugin.config.Flags.Plugin.PassDeviceSpecs {\n  response.Devices = plugin.apiDeviceSpecs(*plugin.config.Flags.NvidiaDriverRoot, requestIds)\n }\n ","s668e72db1630e6":" *plugin.config.Flags.GDSEnabled {\n  response.Envs[","seaa062bc19f023":"\"NVIDIA_GDS\"","s6e30bc5c153556":"\"enabled\"","s25dd8a4977dd2d":"\n }\n ","s17829a226cb69a":" *plugin.config.Flags.MOFEDEnabled {\n  response.Envs[","sed04d175a4cf6a":"\"NVIDIA_MOFED\"","sf7323b63250ef0":"\n }\n\n ","s1940f67d7b683d":" &response, ","sb8b437441999d5":"核心部分就是这一句，添加了一个环境变量","s1ac7f678150d68":"response.Envs = plugin.apiEnvs(plugin.deviceListEnvvar, deviceIDs)\n","sa5bd0e15ab57ff":"而 plugin.deviceListEnvvar 的值来自：","s6ef3e2eb4ace3f":"// NewNvidiaDevicePlugin returns an initialized NvidiaDevicePlugin","sbfca7656397f38":"NewNvidiaDevicePlugin","s41c8193720c19d":"(config *util.DeviceConfig, resourceManager rm.ResourceManager, cdiHandler cdi.Interface, cdiEnabled ","sb760f44fa5965c":"bool","sba5ec51d07a4ac":")","s9f0ce1abd3b4ca":" *NvidiaDevicePlugin {\n _, name := resourceManager.Resource().Split()\n\n deviceListStrategies, _ := spec.NewDeviceListStrategies(*config.Flags.Plugin.DeviceListStrategy)\n\n ","s9e3544d777e4c5":" &NvidiaDevicePlugin{\n  rm:                   resourceManager,\n  config:               config,\n  deviceListEnvvar:     ","sca6bb84c4cba42":"\"NVIDIA_VISIBLE_DEVICES\"","sf153b4ce3b697d":",\n  deviceListStrategies: deviceListStrategies,\n  socket:               kubeletdevicepluginv1beta1.DevicePluginPath + ","se1991893cd6fec":"\"nvidia-\"","sbdf6e83f94a285":" + name + ","scd4b9ce1ef1f2c":"\".sock\"","sf29ffe07fd0ea0":",\n  cdiHandler:           cdiHandler,\n  cdiEnabled:           cdiEnabled,\n  cdiAnnotationPrefix:  *config.Flags.Plugin.CDIAnnotationPrefix,\n\n  ","s2c614930170e6e":"// These will be reinitialized every time the plugin server is restarted.","s9dcca0721b4f88":"\n  server: ","s164af503046bef":",\n  health: ","s306fa526a57a07":",\n  stop:   ","sb270ccca3ca143":",\n }\n}\n","s70724c509f414f":"即：","sfc755a2d111696":"NVIDIA_VISIBLE_DEVICES","s2e779528132d6f":"正好，这个 ENV 就是 NVIDIA deviceplugin 中的实现，设置该环境变量之后 nvidia-container-toolkit 会为有这个环境变量的容器分配 GPU。","s8bd87fa2c322fb":"HAMi 这里则是复用了 nvidia-container-toolkit 的能力将 GPU 分配给 Pod。","sad56f278c6c7e4":"Allocate 方法中核心部分包括三件事情：","s510fb8a97e9468":"HAMi 自定义逻辑（添加用于资源限制的环境变量 CUDA_DEVICE_MEMORY_LIMIT_X 和 CUDA_DEVICE_SM_LIMIT）；（挂载 libvgpu.so 到 Pod 中进行替换）","sc8e79396afa229":"NVIDIA 原生逻辑（添加用于分配 GPU 的 环境变量 NVIDIA_VISIBLE_DEVICES，借助 NVIDIA Container Toolkit 将 GPU 挂载到 Pod 里）","sd478a10f21688f":"6.总结","s1ea06e1b992e4c":"至此，HAMi 的 NVIDIA device plugin 工作原理就很清晰了。","se905efc26b5a14":"首先是 Register 插件注册，可以配置使用和原生 nvidia device plugin 不同的 ResourceName 来进行区分。（另外会额外启动一个后台 goroutine WatchAndRegister 定时将 GPU 信息更新到 Node 对象的 Annoations 上便于 Scheduler 时使用。）","s336efde390bc57":"然后 ListAndWatch 感知设备时也根据配置对 Device 进行复制，让同一个设备能够分配给多个 Pod。（这个和 TimeSlicing 方案一样）","s44beed3bf92339":"最后 Allocate 方法中主要做三件事：","sf43fedf2990c32":"为容器中增加 NVIDIA_VISIBLE_DEVICES 环境变量，借助 NVIDIA Container Toolkit 实现为容器分配 GPU","sd556aa297bfd78":"增加 Mounts 配置，挂载 libvgpu.so 到容器中实现对原始驱动的替换","sd58131e7403954":"为容器中增加部分 HAMi 自定义的环境变量 CUDA_DEVICE_MEMORY_LIMIT_X 和 CUDA_DEVICE_SM_LIMIT，配合 ibvgpu.so 实现 GPU core、memory 的限制","s2c117a80a5575e":"核心其实就是在 Allocate 方法中，给容器中添加 CUDA_DEVICE_MEMORY_LIMIT_X 和 CUDA_DEVICE_SM_LIMIT 环境变量和挂载 libvgpu.so 到容器中实现对原始驱动的替换。","s8b8f0b82d4f632":"当容器启动后，CUDA API 请求先经过 libvgpu.so，然后 libvgpu.so 根据环境变量 CUDA_DEVICE_MEMORY_LIMIT_X 和 CUDA_DEVICE_SM_LIMIT 实现 Core & Memory 限制。","sc0941772731039":"最后回答开篇提出的问题：","sd775608f433b86":"HAMi 为什么要自己实现一个 device plugin 呢？hami-device-plugin-nvidia 是有哪些 NVIDIA 原生 device plugin 没有的功能吗？","sd2ff202a10ea7b":"在 hami device plugin 相比原生的 NVIDIA device plugin 做了几个修改：","sdc92ca67ee1734":"注册时额外启动后台 goroutine WatchAndRegister 定时将 GPU 信息更新到 Node 对象的 Annoations 上便于 Scheduler 时使用。","sb5c3fe63784330":"ListAndWatch 感知设备时也根据配置对 Device 进行复制，便于将同一个物理 GPU 分配给多个 Pod (这个其实原生的 NVIDIA device plugin 也有，就是 TimeSlicing 方案。)","s7d2c517d79a158":"Allocate 中增加了 HAMi 自定义逻辑：","s1cda415862794a":"\n(挂载 libvgpu.so 到容器中实现对原始驱动的替换);(指定部分 HAMi 自定义的环境变量 CUDA_DEVICE_MEMORY_LIMIT_X 和 CUDA_DEVICE_SM_LIMIT，配合 ibvgpu.so 实现 GPU core、memory 的限制)","s0ff7238de51c9c":"7.FAQ","sb7d79f3969de82":"Node 上的 libvgpu.so 是怎么来的","s05cf4ed4de4cdb":"Allocate 方法中要将 libvgpu.so 挂载到 Pod 里，这里用的是 HostPath 方式挂载，说明这个 libvgpu.so 是存在于宿主机上的。","s9c5522450f1254":"那么问题来了，宿主机上的 libvgpu.so 是怎么来的？","sc0996d42838684":"这个实际上是打包在 HAMi 提供的 device-plugin 镜像里的，device-plugin 启动时将其从 Pod 里复制到宿主机上，相关 yaml 如下：","s3973e022e93220":"-","sd0d6d503f5acae":"name:","s5ed993b6681caa":"NVIDIA_MIG_MONITOR_DEVICES","s03a5afeabc5c88":"value:","s5ef5ef0364b693":"all","s3af475bc89e5a0":"HOOK_PATH","s0885fcf5b23ee3":"/usr/local","sa08a30338e824c":"image:","sc0bb238099b3e1":"192.168","s679067521b59b2":".116","s070954f8ef978d":".54","s6b19b9af6174e6":":5000/projecthami/hami:v2.3.13","s233a1a18e8c241":"imagePullPolicy:","s0181198b55cf97":"IfNotPresent","sc44ff6c3591ead":"lifecycle:","sb7e91413085d3c":"postStart:","s6de1593664cd72":"exec:","s8ff7327fcdf50a":"command:","s77bafa9e3a8a09":"/bin/sh","s0c3603e13e24a4":"-c","se44b4bd707c540":"cp","s0e6503c1ece40e":"-f","sca08662c61b9a1":"/k8s-vgpu/lib/nvidia/*","s8f31f2ec7644a4":"/usr/local/vgpu/","se7b4724fc342f6":"device-plugin","scab2be2b3a2ed1":"resources:","sf8e88ae184bb14":" {}\n","s1dbe86986027b7":"securityContext:","sd2e92b405d1b9c":"allowPrivilegeEscalation:","scfb30922e3c6f6":"capabilities:","s274fdf3ffbd776":"add:","s51a9138f42e498":"SYS_ADMIN","scf5449a231324f":"drop:","sb5c7aed7cd2a30":"ALL","s4399c37ea71171":"terminationMessagePath:","sb4233eab819d8a":"/dev/termination-log","sd5b3ecbbcb9e5e":"terminationMessagePolicy:","s50009ce1da4d15":"File","sfcd8c64a8f749e":"volumeMounts:","sd02af9864596e9":"mountPath:","s5db238443f5304":"/var/lib/kubelet/device-plugins","scc988d82909e92":"/usr/local/vgpu","s76b5a357391276":"lib","s807173ef58777c":"挂载了 hostPath 到容器里，然后容器里执行","sd26f8424edb4b1":"cp -f /k8s-vgpu/lib/nvidia/* /usr/local/vgpu/","s4d9ebb26c5e56a":" 命令将其复制到宿主机。","s19600f240f9561":"想了解更多 HAMi 项目信息，请访问 ","s720f02a99a3282":"GitHub 仓库","s7b5127b34ede27":" 或加入我们的 ","sc84290897ca61f":"Slack 社区","s2bebe26c9fc5d2":"继续了解这篇文章","sc2f794ad7de9a9":"正文沿用官网发布内容，技术信息以文章发布时为准。","s28a9b82be369f5":"查看官网原文 ↗","sd0e1d306fe7cf8":"← 返回博客列表","s421185c97f13fb":"本文目录","scadf9eb6ac5351":"KEEP READING","s4ec2a77b1ae3ba":"继续阅读","s1ab08ebf532419":"全部文章","s161660030aa6c9":"→","s24fec467886a9f":"千卡集群 vGPU 调度修复","s9222f2233b725a":"2026.06.01","sdd605f6f73d75e":"千卡集群升级后 Hami vGPU 调度失败解决方案","s380cbe6da507af":"阅读全文 ","saa7fd00290057e":"HAMi DRA 实践指南","sa3366d2f25e775":"2026.05.22","s1afc95974cc093":"HAMi 正式接入 Kubernetes DRA：下一代 GPU 资源模型实践指南","s9d16527d1f8377":"HAMi-DRA 在 KCD Beijing 2026 的技术分享回顾","sa00218f2f7e1a1":"2026.03.23","s6722572c52fae8":"从 Device Plugin 到 DRA：GPU 调度范式升级与 HAMi-DRA 实践"}