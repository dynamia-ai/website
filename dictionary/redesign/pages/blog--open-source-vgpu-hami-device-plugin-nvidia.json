"","sdcc4db1d74463c":"\"DEVICE_MEMORY_SCALING\"","sa50e64b3e2c5a0":"\"device-cores-scaling\"","s03fe54c93f63a3":"\"the ratio for NVIDIA device cores scaling\"","se59f2980025a76":"\"DEVICE_CORES_SCALING\"","s0bc51bef505455":"\"disable-core-limit\"","s6585c684f22e9f":"\"If set, the core utilization limit will be ignored\"","s153777771782a5":"\"DISABLE_CORE_LIMIT\"","sf3c235d2c62b01":"},\n  },\n  &cli.StringFlag{\n   Name:  ","s5262bd309a50de":"\"resource-name\"","s85ca9696d37bcb":",\n   Value: ","s084c3ef0aa4fbe":"\"nvidia.com/gpu\"","s4dfb173f63716f":",\n   Usage: ","s07201368f78de3":"\"the name of field for number GPU visible in container\"","s89e2fa6e2d340c":",\n  },\n }\n ","sbb4fd8119bd4d6":" addition\n}\n","s101e10c9a7ab68":"启动时做了两件事：","sab91c8b3dbf24c":"将插件注册到 Kubelet","s59f9afd938d7ba":"启动一个 gRPC 服务","s1c5fadd7b09d18":"我们只需要关注一下接收的几个参数：","seac5c1338dbf1b":"&cli.UintFlag{\n Name:    ","s1955ef580ad039":",\n Value:   ","se0c58832b2b66f":",\n Usage:   ","s7bf2687c2aaa82":",\n EnvVars: []","se92fd5e75314d5":"},\n},\n&cli.Float64Flag{\n Name:    ","s374c706575e17c":"},\n},\n&cli.BoolFlag{\n Name:    ","s9ac8f2f2cc07f5":"},\n},\n&cli.StringFlag{\n Name:  ","s067e22719539b0":",\n Value: ","s0d894177117a41":",\n Usage: ","s0ffaf67bf97e4d":",\n},\n","sc3a1b5f13df9ef":"device-split-count：表示 GPU 的分割数，每一张 GPU 都不能分配超过其配置数目的任务。若其配置为 N 的话，每个 GPU 上最多可以同时存在 N 个任务。","s1d8cd62579811d":"\n（建议根据 GPU 性能动态调整，一般建议大于 10。）","s26758cad23eb9b":"device-memory-scaling：表示 GPU memory 的 oversubscription(超额订阅)****比例，默认 1.0，大于 1.0 则表示启用虚拟显存（实验功能），不建议修改。","sdae404a6b14d61":"device-cores-scaling：表示 GPU core 的 oversubscription(超额订阅) 比例，默认 1.0。","s87e3d7fdb19aa0":"disable-core-limit：是否关闭 GPU Core Limit，默认 false，不建议修改。resource-name：资源名称，建议改掉，不推荐使用默认的 ","sc49b27b6e3178c":"NVIDIA GPU Resources","sdaf3b46be08dc4":" 因为这个和 nvidia 原生的重复了。","s44631b1aad29c1":"3. Register","sa3a00f8910db2c":"Register 方法实现如下：","s3e89ea240d4407":"// pkg/device-plugin/nvidiadevice/nvinternal/plugin/server.go#L222","s93d3abe744ac86":"// Register registers the device plugin for the given resourceName with Kubelet.","sbf9264d15bd101":"(plugin *NvidiaDevicePlugin)","se11976510d1655":" Register() ","sd3b4990a252842":" {\n conn, err := plugin.dial(kubeletdevicepluginv1beta1.KubeletSocket, ","sef2d127de37b94":"5","s27c827262fae9a":"*time.Second)\n ","sfee7d25143486d":" err\n }\n ","s8f106893acee44":"defer","s01623328214ea2":" conn.Close()\n\n client := kubeletdevicepluginv1beta1.NewRegistrationClient(conn)\n reqt := &kubeletdevicepluginv1beta1.RegisterRequest{\n  Version:      kubeletdevicepluginv1beta1.Version,\n  Endpoint:     path.Base(plugin.socket),\n  ResourceName: ","s004bccc613cf3a":"(plugin.rm.Resource()),\n  Options: &kubeletdevicepluginv1beta1.DevicePluginOptions{\n   GetPreferredAllocationAvailable: ","sf2bf45f9422336":",\n  },\n }\n\n _, err = client.Register(context.Background(), reqt)\n ","s804f89fc0ec98c":"\n}\n","sad47a0d74fe9d0":"device plugin 注册时的几个核心信息：","s4817c9e35f37a1":"ResourceName","s62d3f854373a47":"：资源名称，这个和创建 Pod 时申请 vGPU 的资源名匹配时就会使用到该 device plugin。","s73cf48738a8a6c":"\n（也是可以在 deivce plugin 启动时配置的，一般叫做 --resource-name=nvidia.com/vgpu）","sdd167905de0def":"Version","s9abdd80d9a7fd2":"：device plugin 的版本，这里是 v1beta1","s3df9726c68ba76":"Endpoint","s25daf8812ff165":"：device plugin 的访问地址，Kubelet 会通过这个 sock 和 device plugin 进行交互。","s12ae6c7b0a883f":"\n（hami 用的格式为：/var/lib/kubelet/device-plugins/nvidia-xxx.sock，其中 xxx 是 从 ResourceName 中解析出来的，比如 nvidia.com/vgpu 那么这里的 xx 就是后面的 vgpu。）","sc64b1f7b68d6c3":"假设我们都使用默认值，ResourceName 为 ","sdac884b33ed13a":"nvidia.com/vgpu","s4cbd7e821c84ee":"，Endpoint 为 ","sc9cdfa018fb7f6":"/var/lib/kubelet/device-plugins/nvidia-vgpu.sock","seb0d5884569b39":"。","s27f1e0c0d837bb":"后续 Pod Resource 中申请使用 nvidia.com/vgpu 资源时，就会由该 device plugin 来处理，实现资源分配，Kubelet 则是通过 var/lib/kubelet/device-plugins/nvidia-vgpu.sock 这个 sock 文件调用 device plugin API。","se70e4edc72e47d":"反之，我们在 Pod Resource 中申请使用 nvidia.com/gpu 时，这个 ResourceName 和 hami 插件不匹配，因此不由 hami device plugin nvidia 处理，而是由 nvidia 自己的 device plugin 进行处理。","s91dd75fb735d4a":"WatchAndRegister","s80050992560706":"这个是 HAMi device plugin 中的一个特殊逻辑，将 node 上的 GPU 信息以 annotations 的形式添加到 Node 对象上。","sdfb2a28a768157":"直接通过 kube-apiserver 通信，绕过传统 device-plugin 上报流程。","s7d890e3d75c516":"后续 HAMi-Scheduler 在进行调度时就会用到这边上报的 annotations 作为调度依据的一部分","s6e1cf333c68a44":"，分析 HAMi-Scheduler 时在仔细分析。","sb59cd07a16fbd4":" WatchAndRegister() {\n klog.Info(","s5356b937079ed0":"\"Starting WatchAndRegister\"","s383b7b2e174ebe":")\n errorSleepInterval := time.Second * ","s62a16d2ee93b38":"\n successSleepInterval := time.Second * ","s624b60c58c9d8b":"30","s10c22bcf4c768b":"for","s651b8e3a22c3bf":" {\n  err := plugin.RegistrInAnnotation()\n  ","s6dee621c20a710":" {\n   klog.Errorf(","s0dbe1434bf0e36":"\"Failed to register annotation: %v\"","s07e5c408ff5577":", err)\n   klog.Infof(","s1a76e448fb0825":"\"Retrying in %v seconds...\"","s19d719c254eabc":", errorSleepInterval)\n   time.Sleep(errorSleepInterval)\n  } ","s7dd530c4d36da4":"else","sbe01f65738d60f":" {\n   klog.Infof(","s5c1a38d20c42a5":"\"Successfully registered annotation. Next check in %v seconds...\"","s6d112031d85b4c":", successSleepInterval)\n   time.Sleep(successSleepInterval)\n  }\n }\n}\n","sc1b22b5fe4cf56":"getAPIDevices","sf5da4a8061a39d":"获取 Node 上的 GPU 信息，并组装成 api.DeviceInfo 对象。","s73c3d725d90520":" getAPIDevices() *[]*api.DeviceInfo {\n devs := plugin.Devices()\n nvml.Init()\n res := ","sd05aa2a15fb3c4":"make","sc2ea1338dcc1e4":"([]*api.DeviceInfo, ","s5feceb66ffc86f":"0","s0a07f659461970":", ","s71fa9faaa6f884":"len","s573750ec264e52":"(devs))\n idx := ","sc2e18f12c0c2b3":" idx < ","sa2a0eafb502804":"(devs) {\n  ndev, ret := nvml.DeviceGetHandleByIndex(idx)\n  ","s49bcaaf3fc646f":" ret != nvml.SUCCESS {\n   klog.Errorln(","s616618cd4973f4":"\"nvml new device by index error idx=\"","sb141e2ec292751":", idx, ","s6644b3f421e010":"\"err=\"","s5d9a67fb494809":", ret)\n   ","s79631cb1b7b63b":"panic","s32ebb1abcc1c60":"(","s67347a1289